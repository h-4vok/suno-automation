# Server-only secret. Never put this in extension source or Git.
GEMINI_API_KEY=

# Shared localhost token. `bun run setup:local` replaces this and copies it to the clipboard.
SUNO_EXTENSION_TOKEN=replace-with-a-random-token

SUNO_CONFIG_PATH=config/config.yaml

# Local HMAC key for Codex loop verification verdicts. Generate at least 32 random characters.
CODEX_LOOP_VERIFICATION_KEY=
# Optional absolute override. By default `pnpm loop` resolves the shared config at
# <git-common-dir>/codex-loop/config.yaml so both permanent worker worktrees agree.
# CODEX_LOOP_CONFIG=C:\absolute\path\to\codex-loop\config.yaml
